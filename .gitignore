__pycache__/
*.pyc

# videos de prueba generados (25-65 MB cada uno)
camara/pruebas/*.mp4
camara/pruebas/hoja/hojas*/

# fotos originales del telefono (43 MB, con GPS en el EXIF): las que se
# suben son las reducidas de camara/pruebas/hoja/fotos/
camara/pruebas/hoja/fotos_originales/

# Pruebas con tesseract que no se suben al repositorio
camara/pruebas/tx_camara_tesseract.py

# fotos de trabajo que escribe el transmisor al cargar o capturar: son de
# usar y tirar, y van aparte de camara/pruebas/hoja/fotos/, que es el banco de
# pruebas y esta versionado. Sin carpeta: la escriben tanto camara/tx_camara.py
# como la copia de pruebas.
capturas/

# datos del experimento de aprendizaje: 14 MB y se rehacen corriendo
# sacar_celdas.py y hacer_datos.py, que llevan la semilla fija. El modelo
# entrenado (modelo.npz, medio mega) si se sube.
camara/pruebas/hoja/aprendizaje/celdas.npz
camara/pruebas/hoja/aprendizaje/datos.npz
